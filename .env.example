# ==========================================
# CONFIGURACIÓN DEL SERVIDOR Y EMAIL
# ==========================================
PORT=3001
EMAIL_USER=tu-correo@gmail.com
EMAIL_PASS=tu-contraseña-de-aplicacion-gmail

# ==========================================
# INTEGRACIÓN DE GOOGLE CALENDAR
# ==========================================
# ID del cliente de la consola de Google Cloud Developer Console
GOOGLE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-google-client-secret

# URI de redirección configurada en Google Cloud Console (ej: http://localhost:3000/api/google/callback)
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# ID del Calendario de Google específico (opcional, por defecto usa 'primary')
# Ej: tu-calendario-especifico@group.calendar.google.com o tu-correo@gmail.com
GOOGLE_CALENDAR_ID=

# Token de refresco obtenido tras realizar la primera autenticación en /api/google/auth
# (Obligatorio en producción como Vercel ya que no se puede persistir el archivo local token.json)
GOOGLE_REFRESH_TOKEN=

# Zona horaria para registrar las citas en Google Calendar (ej: America/Panama, America/Mexico_City)
CALENDAR_TIMEZONE=America/Panama
